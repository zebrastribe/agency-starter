{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ember",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#1C1917", "name": "Background" },
				{ "slug": "surface", "color": "#1C1917", "name": "Surface" },
				{ "slug": "foreground", "color": "#D6D3D1", "name": "Foreground" },
				{ "slug": "ink", "color": "#D6D3D1", "name": "Ink" },
				{ "slug": "primary", "color": "#FB923C", "name": "Primary" },
				{ "slug": "primary-hover", "color": "#F97316", "name": "Primary Hover" },
				{ "slug": "primary-subtle", "color": "#431407", "name": "Primary Subtle" },
				{ "slug": "secondary", "color": "#A855F7", "name": "Secondary" },
				{ "slug": "secondary-hover", "color": "#9333EA", "name": "Secondary Hover" },
				{ "slug": "secondary-subtle", "color": "#3B0764", "name": "Secondary Subtle" },
				{ "slug": "accent", "color": "#4ADE80", "name": "Accent" },
				{ "slug": "surface-alt", "color": "#14110F", "name": "Surface Alt" },
				{ "slug": "surface-dark", "color": "#0C0A09", "name": "Surface Dark" },
				{ "slug": "slate", "color": "#A8A29E", "name": "Slate" },
				{ "slug": "muted", "color": "#A8A29E", "name": "Muted" },
				{ "slug": "inverse", "color": "#1C1917", "name": "Inverse" },
				{ "slug": "border", "color": "#292524", "name": "Border" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--foreground)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--inverse)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"on-dark": {
						"color": {
							"background": "var(--wp--preset--color--inverse)",
							"text": "var(--wp--preset--color--foreground)"
						}
					}
				}
			}
		}
	}
}
