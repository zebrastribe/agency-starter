{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "background", "color": "#1D232A", "name": "Background" },
				{ "slug": "surface", "color": "#1D232A", "name": "Surface" },
				{ "slug": "foreground", "color": "#ECF9FF", "name": "Foreground" },
				{ "slug": "ink", "color": "#ECF9FF", "name": "Ink" },
				{ "slug": "primary", "color": "#661AE6", "name": "Primary" },
				{ "slug": "primary-hover", "color": "#7C3AED", "name": "Primary Hover" },
				{ "slug": "primary-subtle", "color": "#2E1065", "name": "Primary Subtle" },
				{ "slug": "secondary", "color": "#F000B8", "name": "Secondary" },
				{ "slug": "secondary-hover", "color": "#FF2DD1", "name": "Secondary Hover" },
				{ "slug": "secondary-subtle", "color": "#4A044E", "name": "Secondary Subtle" },
				{ "slug": "accent", "color": "#1DCDBC", "name": "Accent" },
				{ "slug": "surface-alt", "color": "#191E24", "name": "Surface Alt" },
				{ "slug": "surface-dark", "color": "#0F1419", "name": "Surface Dark" },
				{ "slug": "slate", "color": "#A6ADBB", "name": "Slate" },
				{ "slug": "muted", "color": "#9CA3AF", "name": "Muted" },
				{ "slug": "inverse", "color": "#FFFFFF", "name": "Inverse" },
				{ "slug": "border", "color": "#2A323C", "name": "Border" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--foreground)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--inverse)"
				}
			}
		}
	}
}
